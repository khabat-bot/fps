{
  "name": "web-multiplayer-fps",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:client": "vite --host",
    "build": "tsc --noEmit && vite build",
    "start": "tsx src/server/index.ts"
  },
  "dependencies": {
    "@colyseus/schema": "^2.0.36",
    "colyseus": "^0.15.18",
    "colyseus.js": "^0.15.22",
    "howler": "^2.2.4",
    "nipplejs": "^0.10.2",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@types/howler": "^2.2.11",
    "@types/node": "^22.7.4",
    "@types/three": "^0.169.0",
    "concurrently": "^9.0.1",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vite": "^5.4.8"
  }
}
